<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="filter">
        <field
            name="search"
            type="text"
            inputmode="search"
            label="COM_SERVICEDESKPLUS_MAPPINGS_SEARCH"
            description="COM_SERVICEDESKPLUS_MAPPINGS_SEARCH_DESC"
            hint="JSEARCH_FILTER"
        />
        <field
            name="status"
            type="list"
            label="COM_SERVICEDESKPLUS_MAPPING_STATUS"
            onchange="this.form.submit();"
            validate="options"
        >
            <option value="">COM_SERVICEDESKPLUS_MAPPINGS_SELECT_STATUS</option>
            <option value="active">COM_SERVICEDESKPLUS_STATUS_ACTIVE</option>
            <option value="pending">COM_SERVICEDESKPLUS_STATUS_PENDING</option>
            <option value="suspended">COM_SERVICEDESKPLUS_STATUS_SUSPENDED</option>
            <option value="unmatched">COM_SERVICEDESKPLUS_STATUS_UNMATCHED</option>
            <option value="ambiguous">COM_SERVICEDESKPLUS_STATUS_AMBIGUOUS</option>
        </field>
    </fields>
    <fields name="list">
        <field
            name="fullordering"
            type="list"
            label="JGLOBAL_SORT_BY"
            default="m.checked_at DESC"
            onchange="this.form.submit();"
            validate="options"
        >
            <option value="">JGLOBAL_SORT_BY</option>
            <option value="m.checked_at DESC">COM_SERVICEDESKPLUS_SORT_CHECKED_DESC</option>
            <option value="m.checked_at ASC">COM_SERVICEDESKPLUS_SORT_CHECKED_ASC</option>
            <option value="u.name ASC">COM_SERVICEDESKPLUS_SORT_NAME_ASC</option>
            <option value="u.name DESC">COM_SERVICEDESKPLUS_SORT_NAME_DESC</option>
            <option value="m.status ASC">COM_SERVICEDESKPLUS_SORT_STATUS_ASC</option>
        </field>
        <field
            name="limit"
            type="limitbox"
            label="JGLOBAL_LIST_LIMIT"
            default="25"
            onchange="this.form.submit();"
        />
    </fields>
</form>
